# Database : PostgreSql
# you can change these values as per your need
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=askdb

# Backend
PORT=3001 # by default port runs at 3001
ENV=production

# Application demands user should be able to login with these credentials
ADMIN_EMAIL=admin@local.com
ADMIN_PASSWORD=changeme

# Update the jwt and redis secret (use long random strings)
JWT_SECRET=change-me-to-a-long-random-string
REDIS_ENCRYPTION_SECRET=change-me-to-a-long-random-string

# AI provider: Groq (OpenAI-compatible, free tier at https://console.groq.com)
# Paste your Groq API key here.
AI_API_KEY=your_groq_api_key_here
# Optional: override the Groq model (see https://console.groq.com/docs/models)
# GROQ_MODEL=openai/gpt-oss-120b

# Redis
REDIS_URL=redis://askdb-redis:6379

# Frontend talks to backend api using this url
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
